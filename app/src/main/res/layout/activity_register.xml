<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterActivity"
    android:background="@color/main_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <EditText
            android:id="@+id/name_et"
            android:fontFamily="@font/g"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:hint="@string/name"/>

        <EditText
            android:id="@+id/surname_et"
            android:fontFamily="@font/g"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:hint="@string/surname"/>

        <EditText
            android:id="@+id/email_et"
            android:fontFamily="@font/g"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:inputType="textEmailAddress"
            android:hint="@string/email"/>

        <TextView
            android:layout_width="300dp"
            android:fontFamily="@font/g"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:text="@string/age_capital"
            android:textSize="15dp"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/age_sli"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:valueFrom="0"
            android:valueTo="100"
            app:tickColor="@color/black"
            app:tickColorActive="@color/purple_200" />

        <EditText
            android:id="@+id/username_et"
            android:fontFamily="@font/g"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:hint="@string/username"/>

        <EditText
            android:id="@+id/password_et"
            android:fontFamily="@font/g"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:inputType="textPassword"
            android:hint="@string/password"/>

        <ImageView
            android:id="@+id/register_iv"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:src="@drawable/register_button"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>