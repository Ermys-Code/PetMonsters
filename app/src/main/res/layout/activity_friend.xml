<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_house">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/friends_iv"
            android:layout_width="150dp"
            android:layout_height="425dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="40dp"
            android:src="@drawable/door"
            android:layout_marginBottom="43dp"/>

        <ImageView
            android:id="@+id/board_iv"
            android:src="@drawable/board"
            android:layout_width="125dp"
            android:layout_height="97dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="175dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/pet_iv"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:layout_marginTop="75dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/hat_iv"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginLeft="6dp"
            android:layout_gravity="center"
            android:layout_marginBottom="65dp"/>

        <ImageView
            android:id="@+id/shoes_iv"
            android:layout_width="210dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="190dp"/>

        <TextView
            android:id="@+id/name_tv"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="20dp"
            android:fontFamily="@font/grobold"
            android:text="@string/name"
            android:textColor="@color/pet_name_letter"
            android:gravity="center"
            android:textAlignment="center"
            android:textSize="40dp"
            android:background="@drawable/name_fondo"/>

        <TextView
            android:id="@+id/petname_tv"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:fontFamily="@font/g"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            android:layout_gravity="right"
            android:textSize="35dp"
            android:textColor="@color/money_letter"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/money_fondo"/>

    </FrameLayout>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_gravity="center"
        android:layout_marginRight="50dp"
        android:layout_marginLeft="50dp"
        android:layout_height="300dp">



    </androidx.fragment.app.FragmentContainerView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_create_note"
        android:layout_width="match_parent"
        android:layout_gravity="center"
        android:layout_marginRight="50dp"
        android:layout_marginLeft="50dp"
        android:layout_height="300dp">



    </androidx.fragment.app.FragmentContainerView>


</FrameLayout>